{
  "version": "1.9",
  "importedFrom": "./",
  "configurations": [
    {
      "name": "default",
      "id": "conf1",
      "device": "ATtiny2313A",
      "imageType": "application",
      "imagePath": "./out/ECE_312_lab2_complete/default.elf",
      "toolProperties": "default-tool",
      "tool": "snap",
      "packs": [
        {
          "name": "ATtiny_DFP",
          "vendor": "Microchip",
          "version": "3.4.278"
        }
      ],
      "fileSet": "Project files",
      "toolchain": "default-AVR-GCC",
      "includeLegacyMacros": true
    }
  ],
  "propertyGroups": [
    {
      "name": "default-AVR-GCC",
      "type": "toolchain",
      "provider": "microchip.toolchains:avr-gcc@15.1.0",
      "properties": {
        "compiler.additional-warnings": true,
        "compiler.call-prologues": false,
        "compiler.default-bitfield-type": true,
        "compiler.default-char-type": true,
        "compiler.extra-include-directories": ".",
        "compiler.extra-warnings": false,
        "compiler.garbage-collect-data": true,
        "compiler.garbage-collect-functions": true,
        "compiler.inhibit-all": false,
        "compiler.make-warnings-into-errors": false,
        "compiler.no-interrupts": false,
        "compiler.no-system-directories": false,
        "compiler.optimization-level": "-O1",
        "compiler.pack-struct": true,
        "compiler.save-temps": false,
        "compiler.short-calls": false,
        "compiler.short-enums": true,
        "compiler.strict-ansi": false,
        "compiler.strict-ansi-errors": false,
        "compiler.support-ansi": false,
        "compiler.syntax-only": false,
        "compiler.undefined-identifier": false,
        "compiler.verbose": false,
        "compiler++.additional-warnings": true,
        "compiler++.call-prologues": false,
        "compiler++.default-bitfield-type": true,
        "compiler++.default-char-type": true,
        "compiler++.extra-include-directories": ".",
        "compiler++.garbage-collect-data": true,
        "compiler++.garbage-collect-functions": true,
        "compiler++.inhibit-all": false,
        "compiler++.make-warnings-into-errors": false,
        "compiler++.no-interrupts": false,
        "compiler++.no-system-directories": false,
        "compiler++.optimization-level": "-O1",
        "compiler++.pack-struct": true,
        "compiler++.preprocess-only": false,
        "compiler++.save-temps": false,
        "compiler++.short-calls": false,
        "compiler++.short-enums": true,
        "compiler++.strict-ansi": false,
        "compiler++.strict-ansi-errors": false,
        "compiler++.support-ansi": false,
        "compiler++.syntax-only": false,
        "compiler++.undefined-identifier": false,
        "compiler++.verbose": false,
        "assembler.announce-version": false,
        "assembler.suppress-warnings": false,
        "archiver.archiver-flags": "-r",
        "linker.exclude-standard-libraries": false,
        "linker.extra-lib-directories": ".",
        "linker.generate-map-file": true,
        "linker.input-libraries": "m",
        "linker.no-default-libs": false,
        "linker.no-shared-libraries": false,
        "linker.no-startup-files": false,
        "linker.omit-symbol-information": false,
        "linker.remove-unused-sections": true,
        "linker.rodata-writable": false,
        "linker.v-printf": false,
        "global.eep": false,
        "global.external-ram-check": false,
        "global.hex": true,
        "global.lss": false,
        "global.omit-pack-options": false,
        "global.relax-branches": false,
        "global.srec": false,
        "global.usersig": false
      }
    },
    {
      "name": "default-tool",
      "type": "tool",
      "properties": {
        "AutoSelectMemRanges": "auto",
        "ToolFirmwareFilePath": "Press to browse for a specific firmware version",
        "ToolFirmwareOption.UpdateOptions": "ToolFirmwareOption.UseLatest",
        "ToolFirmwareToolPack": "Press to select which tool pack to use",
        "communication.interface": "isp",
        "communication.interface.jtag": "2wire",
        "communication.speed": "0.125",
        "debugoptions.debug-startup": "Use system settings",
        "debugoptions.reset-behaviour": "Use system settings",
        "debugoptions.simultaneous.debug": false,
        "debugoptions.useswbreakpoints": false,
        "event.recorder.debugger.behavior": "Running",
        "event.recorder.enabled": false,
        "freeze.timers": false,
        "memories.aux": false,
        "memories.bootflash": true,
        "memories.configurationmemory": true,
        "memories.configurationmemory2": true,
        "memories.dataflash": true,
        "memories.eeprom": true,
        "memories.exclude.configurationmemory": true,
        "memories.flashdata": true,
        "memories.id": true,
        "memories.instruction.ram.ranges": "${memories.instruction.ram.ranges}",
        "memories.programmemory": true,
        "memories.programmemory.ranges": "0-3ff",
        "programoptions.donoteraseauxmem": false,
        "programoptions.eraseb4program": true,
        "programoptions.pgmentry.voltage": "low",
        "programoptions.pgmspeed": "Med",
        "programoptions.preservedataflash": false,
        "programoptions.preservedataflash.ranges": "0-7f",
        "programoptions.preserveeeprom": false,
        "programoptions.preserveprogramrange": false,
        "programoptions.preserveuserid": false,
        "programoptions.program.otpconfig": false,
        "programoptions.programcalmem": false,
        "programoptions.programuserotp": false,
        "programoptions.smart.program": "When debugging only",
        "programoptions.testmodeentrymethod": "VDDFirst",
        "toolpack.updateoptions": "toolpack.updateoptions.uselatestoolpack",
        "toolpack.updateoptions.packversion": "Press to select which tool pack to use",
        "programmerToGoFilePath": "E:/github_repo/ece_312_labs/ECE_312_lab2_complete.X/debug/default/ECE_312_lab2_complete_ptg"
      }
    }
  ],
  "fileSets": [
    {
      "name": "Project files",
      "files": [
        "*"
      ],
      "encoding": "ISO-8859-1"
    }
  ]
}